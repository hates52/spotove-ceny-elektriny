FROM node:26-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY packages/web-app/package.json ./packages/web-app/
RUN npm ci --workspace=@spotove-ceny-elektriny/web-app

COPY packages/web-app/ ./packages/web-app/

RUN npm run build --workspace=@spotove-ceny-elektriny/web-app

FROM node:26-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

ARG COMMIT
LABEL org.opencontainers.image.revision=${COMMIT}

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/web-app/.next ./packages/web-app/.next
COPY --from=builder /app/packages/web-app/package.json ./packages/web-app/package.json
COPY --from=builder /app/packages/web-app/public ./packages/web-app/public
COPY --from=builder /app/packages/web-app/next.config.js ./packages/web-app/next.config.js

RUN cd packages/web-app && npx eslint --max-warnings=0 .

CMD ["npm", "run", "start", "--workspace=@spotove-ceny-elektriny/web-app"]
