{
  "name": "spotove-ceny-elektriny-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@spotove-ceny-elektriny/backend",
    "dev:web": "npm run dev --workspace=@spotove-ceny-elektriny/web-app",
    "build:backend": "npm run build --workspace=@spotove-ceny-elektriny/backend",
    "build:web": "npm run build --workspace=@spotove-ceny-elektriny/web-app",
    "start:backend": "npm run start --workspace=@spotove-ceny-elektriny/backend",
    "start:web": "npm run start --workspace=@spotove-ceny-elektriny/web-app"
  }
}
